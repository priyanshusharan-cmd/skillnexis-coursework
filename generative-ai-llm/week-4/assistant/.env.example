# Copy to .env. Everything is optional: with nothing set, the assistant runs fully offline (extractive answers).
ADMIN_KEY=change-me-to-a-long-random-string     # bootstraps an 'admin' user with this API key
GEMINI_API_KEY=                                 # free at https://aistudio.google.com  -> LLM answers + image understanding
GEMINI_MODEL=gemini-2.5-flash
# OPENAI_API_KEY=  OPENAI_BASE_URL=  OPENAI_MODEL=     # any OpenAI-compatible API (Groq, OpenRouter free models)
# OLLAMA_MODEL=qwen2.5:1.5b                            # local model via Ollama
RATE_LIMIT_PER_MIN=30
