{
 "openapi": "3.1.0",
 "info": {
  "title": "PEP Assistant API",
  "description": "A domain assistant for **Python Enhancement Proposals** and your own documents.\n\n**Auth:** send your API key as `Authorization: Bearer <key>` (or `X-API-Key`).\n\n**Errors** are JSON: `{\"error\": {\"code\", \"message\", \"request_id\"}}`.\n\n**Streaming:** `POST /v1/chat` with `\"stream\": true` returns Server-Sent Events: `meta`, many `token`, then `done`.",
  "version": "1.0.0"
 },
 "paths": {
  "/v1/chat": {
   "post": {
    "tags": [
     "chat"
    ],
    "summary": "Chat",
    "description": "Ask a question. Retrieval-augmented, cited, memory-aware, guarded and hallucination-checked.",
    "operationId": "chat_v1_chat_post",
    "parameters": [
     {
      "name": "authorization",
      "in": "header",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "description": "Bearer <API key>",
       "title": "Authorization"
      },
      "description": "Bearer <API key>"
     },
     {
      "name": "x-api-key",
      "in": "header",
      "required": false,
      "schema": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "title": "X-Api-Key"
      }
     }
    ],
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/ChatIn"
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "JSON, or an SSE stream when stream=true",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/ChatOut"
        }
       },
       "text/event-stream": {}
      }
     },
     "400": {
      "description": "guardrail_blocked"
     },
     "401": {
      "description": "unauthorized"
     },
     "429": {
      "description": "rate_limited / budget_exceeded"
     },
     "422": {
      "description": "Validation Error",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/HTTPValidationError"
        }
       }
      }
     }
    }
   }
  },
