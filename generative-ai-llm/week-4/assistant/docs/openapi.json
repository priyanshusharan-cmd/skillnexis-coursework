 "components": {
  "schemas": {
   "Body_upload_v1_documents_post": {
    "properties": {
     "file": {
      "type": "string",
      "contentMediaType": "application/octet-stream",
      "title": "File",
      "description": "PDF, PNG/JPEG/WebP image, or UTF-8 text"
     }
    },
    "type": "object",
    "required": [
     "file"
    ],
    "title": "Body_upload_v1_documents_post"
   },
   "ChatIn": {
    "properties": {
     "message": {
      "type": "string",
      "title": "Message",
      "description": "The user's question (max 2,000 characters)",
      "examples": [
       "What does the walrus operator := do?"
      ]
     },
     "session_id": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Session Id",
      "description": "Reuse to keep conversation memory; omitted = a new session",
      "examples": [
       "demo-1"
      ]
     },
     "stream": {
      "type": "boolean",
      "title": "Stream",
      "description": "true = Server-Sent Events token stream",
      "default": false
     },
     "top_k": {
      "type": "integer",
      "maximum": 10.0,
      "minimum": 1.0,
      "title": "Top K",
      "description": "How many source chunks to retrieve",
      "default": 5
     }
    },
    "type": "object",
    "required": [
     "message"
    ],
    "title": "ChatIn"
   },
   "ChatOut": {
    "properties": {
     "session_id": {
      "type": "string",
      "title": "Session Id"
     },
     "answer": {
      "type": "string",
      "title": "Answer"
     },
     "status": {
      "type": "string",
      "enum": [
       "ok",
       "off_domain",
       "blocked"
      ],
      "title": "Status"
     },
     "sources": {
      "items": {
       "$ref": "#/components/schemas/Source"
      },
      "type": "array",
      "title": "Sources"
     },
     "grounding": {
      "additionalProperties": true,
      "type": "object",
      "title": "Grounding",
      "description": "Hallucination check: share of supported sentences, per-sentence evidence, flagged"
     },
     "usage": {
      "additionalProperties": true,
      "type": "object",
      "title": "Usage",
      "description": "prompt/completion tokens (exact or estimated), cost in USD, provider, model"
     },
     "redacted": {
      "items": {
       "type": "string"
      },
      "type": "array",
      "title": "Redacted",
      "description": "Kinds of personal data removed from the question"
     },
     "warnings": {
      "items": {
       "type": "string"
      },
      "type": "array",
      "title": "Warnings"
     }
    },
    "type": "object",
    "required": [
     "session_id",
     "answer",
     "status",
     "sources",
     "grounding",
     "usage",
     "redacted",
     "warnings"
    ],
    "title": "ChatOut"
   },
   "CheckIn": {
    "properties": {
     "answer": {
      "type": "string",
      "title": "Answer",
      "examples": [
       "The walrus operator := assigns a value inside an expression [1]."
      ]
     },
     "question": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Question",
      "description": "If sources are omitted, they are retrieved for this question"
     },
     "sources": {
      "anyOf": [
       {
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       {
        "type": "null"
       }
      ],
      "title": "Sources",
      "description": "Source passages; [1] refers to the first"
     }
    },
    "type": "object",
    "required": [
     "answer"
    ],
    "title": "CheckIn"
   },
   "HTTPValidationError": {
    "properties": {
     "detail": {
      "items": {
       "$ref": "#/components/schemas/ValidationError"
      },
      "type": "array",
      "title": "Detail"
     }
    },
    "type": "object",
    "title": "HTTPValidationError"
   },
   "Source": {
    "properties": {
     "n": {
      "type": "integer",
      "title": "N"
     },
     "source": {
      "type": "string",
      "title": "Source"
     },
     "title": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Title"
     },
     "page": {
      "anyOf": [
       {
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "title": "Page"
     },
     "url": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
