{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "OwnPrefixOnly",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject"],
      "Resource": "arn:aws:s3:::study-links-attachments/${aws:username}/*"
    },
    {
      "Sid": "ListOwnPrefix",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::study-links-attachments",
      "Condition": {"StringLike": {"s3:prefix": ["${aws:username}/*"]}}
    }
  ]
}
