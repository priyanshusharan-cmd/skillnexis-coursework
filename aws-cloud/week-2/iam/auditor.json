{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadConfigurationNotData",
      "Effect": "Allow",
      "Action": ["ec2:Describe*", "s3:GetBucketPolicy", "s3:GetBucketPublicAccessBlock", "s3:GetEncryptionConfiguration",
                 "s3:ListAllMyBuckets", "iam:GetAccountSummary", "iam:ListUsers", "iam:ListMFADevices",
                 "cloudtrail:DescribeTrails", "cloudtrail:GetTrailStatus"],
      "Resource": "*"
    }
  ]
}
