        {
          "name": "POST /api/orders - place order",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 201', () => pm.response.to.have.status(201));",
                  "const o = pm.response.json();",
                  "pm.test('order has id, items and ship-to', () => { pm.expect(o.id).to.be.a('number'); pm.expect(o.items).to.have.lengthOf(1); pm.expect(o.shipTo.postalCode).to.eql('560019'); });",
                  "pm.environment.set('orderId', o.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
