                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "PUT /api/cart/{{productId}} - qty 11 is 400",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 400', () => pm.response.to.have.status(400));",
                  "pm.test('explains the rule', () => pm.expect(pm.response.json().error).to.include('1 to 10'));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/cart/{{productId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
