          "name": "POST /api/orders - invalid details is 400",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 400', () => pm.response.to.have.status(400));",
                  "pm.test('lists email and PIN errors', () => pm.expect(pm.response.json().errors).to.eql(['Enter a valid email address','PIN code must be 6 digits']));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
