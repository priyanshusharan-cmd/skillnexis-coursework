  {
   "parameters": {
    "jsCode": "// Step 2: validate + normalise every new row\nreturn $input.all().map(item => {\n  const r = item.json;\n  const email = String(r['Email address'] || '').trim().toLowerCase();\n  const name = String(r['Full name'] || '').trim().replace(/\\s+/g, ' ').replace(/\\b\\w/g, c => c.toUpperCase());\n  const exp = String(r['Coding experience'] || '').toLowerCase();\n  const valid = !!name && /^[^\\s@]+@[^\\s@]+\\.[a-z]{2,}$/i.test(email);\n  const track = /never|none|beginner/.test(exp) ? 'Python from zero' : /some|little|school/.test(exp) ? 'Python from zero (fast)' : 'Debugging basics';\n  return { json: { row_number: r.row_number, email, name, first: name.split(' ')[0], track, valid,\n                   problem: !name ? 'name missing' : (valid ? '' : 'invalid email') } };\n});"
   },
   "name": "2 · Validate & normalise",
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    240,
    300
   ],
   "id": "5ab7ade3-b228-5bc1-8dc4-a28bb7c44ec7"
  },
  {
   "parameters": {
    "conditions": {
     "boolean": [
