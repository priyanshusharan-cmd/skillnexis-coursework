---
config:
  flowchart:
    curve: linear
---
graph TD;
	__start__([<p>__start__</p>]):::first
	planner(planner)
	researcher(researcher)
	analyst(analyst)
	writer(writer)
	reviewer(reviewer)
	__end__([<p>__end__</p>]):::last
	__start__ --> planner;
	analyst --> writer;
	planner --> researcher;
	researcher --> analyst;
	reviewer -.-> __end__;
	reviewer -.-> writer;
	writer --> reviewer;
	classDef default fill:#f2f0ff,line-height:1.2
	classDef first fill-opacity:0
	classDef last fill:#bfb6fc
